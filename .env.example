# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EMAIL CONFIGURATION (Optional - for sending automated emails via SMTP or API service)
# SMTP Provider Settings (e.g., Gmail, Outlook, Amazon SES SMTP, Mailgun SMTP, SendGrid SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@sanctuarycov.org"
SMTP_PASS="your-app-password-or-api-key"
SMTP_SECURE="false" # true for 465, false for 587/other

# Sender Email Address
EMAIL_FROM="Sanctuary Covenant Church <no-reply@sanctuarycov.org>"

# Resend API Key (Alternative modern email provider: https://resend.com)
RESEND_API_KEY=""

# SendGrid API Key (Alternative: https://sendgrid.com)
SENDGRID_API_KEY=""
